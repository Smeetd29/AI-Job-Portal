# Django settings
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True

# Email configuration (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password

# AI & Embedding models (Optional - pipeline falls back gracefully to local models)
HUGGINGFACE_API_KEY=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
AI_INSIGHTS_TIMEOUT_SECONDS=20
AI_INSIGHTS_MAX_TOKENS=1400
AI_INSIGHTS_MAX_RESUME_CHARS=18000

# Staging pilot registration gate (leave disabled for local development)
PILOT_INVITE_ONLY=False
PILOT_INVITED_EMAILS=
